{
  "name": "devda-extension",
  "displayName": "DEVDA - AI Senior Developer",
  "version": "1.0.0",
  "description": "Your AI-powered Senior Developer assistant. Index your codebase, get context-aware help, convert UI screenshots to code, and more!",
  "author": "Your Name <your.email@example.com>",
  "homepage": "https://github.com/yourusername/devda",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.441.0",
    "plasmo": "^0.89.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "storage",
      "sidePanel"
    ],
    "host_permissions": [
      "http://localhost:3000/*"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
}